local function createPage()
    local page = Instance.new("ScrollingFrame")
    page.Parent = ContentHolder
    page.BackgroundTransparency = 1
    page.Size = UDim2.new(1, 0, 1, 0)
    page.CanvasSize = UDim2.new(0, 0, 1.5, 0)
    page.Visible = false
    return page
end

local PagePlayer = createPage()
local PageFarm = createPage()
local PageTeleport = createPage()

PagePlayer.Visible = true

local function createTabButton(name, positionY, targetPage)
    local btn = Instance.new("TextButton")
    btn.Parent = TabHolder
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.Position = UDim2.new(0.05, 0, positionY, 0)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansBold
    
    local corner = Instance.new("UICorner")
    corner.Parent = btn
    corner.CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        PagePlayer.Visible = false
        PageFarm.Visible = false
        PageTeleport.Visible = false
        targetPage.Visible = true
    end)
end

createTabButton("Player", 0.05, PagePlayer)
createTabButton("Auto Farm", 0.18, PageFarm)
createTabButton("Teleport", 0.31, PageTeleport)

local SpeedBtn = Instance.new("TextButton")
SpeedBtn.Parent = PagePlayer
SpeedBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
SpeedBtn.Position = UDim2.new(0.05, 0, 0.05, 0)
SpeedBtn.Size = UDim2.new(0.9, 0, 0, 40)
SpeedBtn.Text = "Set WalkSpeed (80)"
SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBtn.TextSize = 14
SpeedBtn.Font = Enum.Font.SourceSansBold
local sc = Instance.new("UICorner") sc.Parent = SpeedBtn sc.CornerRadius = UDim.new(0, 6)

SpeedBtn.MouseButton1Click:Connect(function()
    local player = game.Players.LocalPlayer
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = 80
    end
end)

local FarmBtn = Instance.new("TextButton")
FarmBtn.Parent = PageFarm
FarmBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
FarmBtn.Position = UDim2.new(0.05, 0, 0.05, 0)
FarmBtn.Size = UDim2.new(0.9, 0, 0, 40)
FarmBtn.Text = "Toggle Auto Farm"
FarmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FarmBtn.TextSize = 14
FarmBtn.Font = Enum.Font.SourceSansBold
local fc = Instance.new("UICorner") fc.Parent = FarmBtn fc.CornerRadius = UDim.new(0, 6)

local farming = false
FarmBtn.MouseButton1Click:Connect(function()
    farming = not farming
    if farming then
        FarmBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        FarmBtn.Text = "Auto Farm: ON"
    else
        FarmBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        FarmBtn.Text = "Auto Farm: OFF"
    end
end)

